# Copy to .env.local (git-ignored) and fill in.
# Supabase dashboard → Project Settings → Data API (URL) and API Keys (publishable key).
# The publishable key is safe in the browser. NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# BaselineX .NET API
VITE_API_URL=http://localhost:5261
